# Veřejné jméno značky na webu i ve widgetu
NEXT_PUBLIC_BRAND_NAME=Ateliér venku

# AI Onboarding (/admin/generator → POST /api/generate-from-url)
# Preferováno: Google Gemini (AI Studio) přes @ai-sdk/google.
GOOGLE_GENERATIVE_AI_API_KEY=
# Alternativa: Vercel AI Gateway (model google/gemini-2.5-flash).
AI_GATEWAY_API_KEY=
# Alternativa: přímý OpenAI klíč.
OPENAI_API_KEY=
# Poznámka: konfigurace firem se ukládá do data/companies.json (Node.js runtime).
# Lokálně/demo to funguje; na Vercel je filesystem často jen pro čtení — pro produkci
# později nahraďte DB / Blob. Zápis běží jen v Node runtime (ne Edge).

# Resend — https://resend.com
# Odesílatel musí být na ověřené doméně.
RESEND_API_KEY=
RESEND_FROM="Ateliér venku <poptavky@vase-domena.cz>"
# Příjemci poptávek, více adres oddělte čárkou.
LEAD_TO_EMAIL=majitel@vase-domena.cz

# Google Apps Script web app (nasazení: kdokoli, metoda POST).
# Tajemství čte skript z těla JSON, Apps Script nespolehlivě vidí vlastní hlavičky.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
